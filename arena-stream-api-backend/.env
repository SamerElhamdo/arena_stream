# Django Environment Variables
DJANGO_SECRET=change-me-to-secure-random-string-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.arenastream.com

# Database
DB_NAME=arenastream
DB_USER=arenastream
DB_PASS=arenastream123
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Streaming Service
STREAMER_URL=http://localhost:8080

# Security
HMAC_SECRET=supersecretkey-change-me-12345
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@arenastream.com
EMAIL_HOST_PASSWORD=your-email-password
